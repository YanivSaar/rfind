[Unit]
Description=rfind filesystem indexing daemon
Documentation=https://github.com/YanivSaar/rfind
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rfindd
# rfind config / rfind reload: re-read the configuration in place.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Runtime directory for progress.json
RuntimeDirectory=rfindd
RuntimeDirectoryMode=0755

# Logging: structured output goes to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rfindd

# The index lists every file name on the system: keep it root-only.
UMask=0077
StateDirectory=rfindd
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
